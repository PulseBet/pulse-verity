{
  "name": "ai-sdk-tool-pulse-verity",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node example.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.73",
    "pulse-verity": "1.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "6.0.3",
    "ai": "7.0.137"
  },
  "version": "0.1.0",
  "description": "AI SDK tool for reading and verifying signed Pulse Verity Index crypto price records",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PulseBet/pulse-verity.git",
    "directory": "integrations/ai-sdk"
  },
  "homepage": "https://pulsebet.github.io/pulse-verity/ai-sdk/",
  "bugs": {
    "url": "https://github.com/PulseBet/pulse-verity/issues"
  },
  "keywords": [
    "ai-sdk",
    "ai-sdk-tool",
    "crypto",
    "price-index",
    "mcp",
    "signed-prices"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "ai": "^7.0.137"
  }
}
